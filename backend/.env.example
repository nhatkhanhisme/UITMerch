# Server
SERVER_PORT=8080

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://your-host:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=your-username
SPRING_DATASOURCE_PASSWORD=your-password

# Mail
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true

# Supabase Storage
SUPABASE_STORAGE_ENDPOINT=https://your-project.supabase.com/storage/v1/s3
SUPABASE_PROJECT_URL=https://your-project.supabase.com
SUPABASE_STORAGE_REGION=your-region
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=your-access-key
SUPABASE_STORAGE_S3_SECRET_KEY=your-secret-key

# JWT
APP_JWT_SECRET=your-jwt-secret

# CORS — comma-separated list of allowed origins (no trailing slash, no spaces)
# Add exact deployed frontend origins to this list when deploying.
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example

# Swagger UI — set to true only on staging; keep false (default) in production
SWAGGER_ENABLED=false

# AI — Google Gemini visual search (free tier: aistudio.google.com → Get API key)
# Use GEMINI_API_KEYS (comma-separated, recommended) for automatic key rotation on 429.
# Use GEMINI_API_KEY as a fallback for a single key (backward-compatible).
GEMINI_API_KEYS=your-key-1,your-key-2
GEMINI_API_KEY=
APP_ENVIRONMENT=production
APP_DEV_OTP_ENDPOINT=false
APP_DEV_SEED_DATA=false
APP_DEV_MOCK_MAIL=false

APP_AUTH_COOKIE_SECURE=true
APP_RATE_LIMIT_SHARED=true
APP_CHECKOUT_EXPIRY_ENABLED=true
APP_CHECKOUT_MAX_QUANTITY=10
APP_CHECKOUT_MAX_PENDING=3
APP_CHECKOUT_PENDING_HOURS=48

# Flyway uses a session pooler connection for session advisory locks.
# Set these separately in deployment secrets when runtime JDBC credentials are embedded in its URL.
# SPRING_FLYWAY_URL=jdbc:postgresql://your-pooler-host:5432/postgres?sslmode=require&prepareThreshold=0
# SPRING_FLYWAY_USER=postgres.your-project-ref
# SPRING_FLYWAY_PASSWORD=your-database-password

# Durable private PostgreSQL security audit; 1–365 days, default 90.
APP_AUDIT_RETENTION_DAYS=90
